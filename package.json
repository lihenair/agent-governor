{
  "name": "agent-governor",
  "version": "0.7.1",
  "description": "Deterministic Runtime Guardrails for Claude Code & AI Coding Agents",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-governor": "./bin/governor.js",
    "governor": "./bin/governor.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./pre-tool-use": "./src/pre-tool-use.js",
    "./post-tool-use": "./src/post-tool-use.js"
  },
  "files": [
    "bin",
    "src",
    "python",
    "native",
    "adapters",
    ".claude-plugin",
    "rulebooks",
    "governor.config.example.json",
    "governor.config.schema.json",
    "README.md",
    "README_ZH.md",
    "CHANGELOG.md",
    "LICENSE",
    "governor.config.json"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec test/*.test.js",
    "build": "node scripts/build.js",
    "prepublishOnly": "npm test && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude-code",
    "hooks",
    "guardrails",
    "ai-agents",
    "security",
    "ast",
    "policy",
    "python",
    "rust",
    "golang",
    "polyglot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lihenair/agent-governor.git"
  },
  "bugs": {
    "url": "https://github.com/lihenair/agent-governor/issues"
  },
  "homepage": "https://github.com/lihenair/agent-governor#readme",
  "author": "lihenair",
  "dependencies": {
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "shell-quote": "^1.10.0"
  },
  "peerDependencies": {
    "@ast-grep/napi": "^0.45.3"
  },
  "peerDependenciesMeta": {
    "@ast-grep/napi": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ast-grep/lang-c": "^0.0.6",
    "@ast-grep/lang-cpp": "^0.0.6",
    "@ast-grep/lang-dart": "^0.0.7",
    "@ast-grep/lang-go": "^0.0.6",
    "@ast-grep/lang-java": "^0.0.7",
    "@ast-grep/lang-kotlin": "^0.0.7",
    "@ast-grep/lang-rust": "^0.0.7",
    "@ast-grep/lang-swift": "^0.0.8",
    "@ast-grep/napi": "^0.45.3",
    "esbuild": "^0.25.9"
  }
}
