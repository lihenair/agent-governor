{
  "protectedFiles": [
    "tsconfig.json",
    "tsconfig.node.json",
    "biome.json",
    ".eslintrc",
    ".eslintrc.js",
    ".eslintrc.cjs",
    ".eslintrc.json",
    ".prettierrc",
    ".prettierrc.js",
    ".prettierrc.json",
    "package.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "package-lock.json",
    "pyproject.toml",
    "requirements.txt",
    "setup.py",
    "setup.cfg",
    "Pipfile",
    "Pipfile.lock",
    "Cargo.toml",
    "Cargo.lock",
    "go.mod",
    "go.sum",
    "CMakeLists.txt",
    "Makefile",
    "pubspec.yaml",
    "pubspec.lock",
    "Podfile",
    "Podfile.lock",
    "Package.swift",
    "build.gradle",
    "settings.gradle",
    "settings.gradle.kts",
    "AndroidManifest.xml",
    "governor.config.js",
    "governor.config.cjs",
    "governor.config.mjs",
    "governor.config.json"
  ],
  "protectedDirectories": [
    ".claude/",
    ".agent-governor/"
  ],
  "forbiddenBashPatterns": [
    "git\\s+commit[\\s\\S]*--no-verify",
    "git\\s+push[\\s\\S]*--no-verify",
    "rm\\s+-rf\\s+\\.git\\b",
    "npm\\s+set\\s+strict-ssl\\s+false",
    "pip(?:3)?\\s+install[\\s\\S]*--insecure",
    "cargo\\s+publish[\\s\\S]*--no-verify",
    "git\\s+push[\\s\\S]*--force(?:-with-lease)?",
    "git\\s+push[\\s\\S]*\\s-f\\s+(?:origin\\s+)?(?:main|master)\\b"
  ],
  "astRules": {
    "noDirectEval": true,
    "noNewFunction": true,
    "requireErrorBoundary": false,
    "pythonForbiddenCalls": [
      "eval",
      "exec"
    ],
    "pythonDeprecatedImports": [
      "imp",
      "optparse"
    ],
    "rustForbidUnsafe": true,
    "goForbidPanic": false,
    "dartForbidMirrors": true,
    "swiftForbidForceTry": true,
    "kotlinForbidBangBang": true,
    "cppForbidUnsafeC": true,
    "javaForbidRuntimeExec": true
  },
  "injectionMode": "scan",
  "injectionPatterns": [],
  "engine": "regex"
}
